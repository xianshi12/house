<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.DeveloperDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.DeveloperEntity" id="developerMap">
        <result property="developerCode" column="developer_code"/>
        <result property="password" column="password"/>
        <result property="developerName" column="developer_name"/>
        <result property="gender" column="gender"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="avatar" column="avatar"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.DeveloperVO" >
		SELECT * FROM developer  developer         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.DeveloperVO" >
		SELECT  developer.* FROM developer  developer 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.DeveloperView" >

		SELECT  developer.* FROM developer  developer 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.DeveloperView" >
		SELECT * FROM developer  developer <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
