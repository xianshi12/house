<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.ViewingReservationDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.ViewingReservationEntity" id="viewingReservationMap">
        <result property="propertyName" column="property_name"/>
        <result property="houseType" column="house_type"/>
        <result property="propertyImage" column="property_image"/>
        <result property="salePrice" column="sale_price"/>
        <result property="floorArea" column="floor_area"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="address" column="address"/>
        <result property="developerCode" column="developer_code"/>
        <result property="developerName" column="developer_name"/>
        <result property="appointmentTime" column="appointment_time"/>
        <result property="account" column="account"/>
        <result property="fullName" column="full_name"/>
        <result property="phone" column="phone"/>
        <result property="registerTime" column="register_time"/>
        <result property="auditStatus" column="audit_status"/>
        <result property="auditReply" column="audit_reply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.ViewingReservationVO" >
		SELECT * FROM viewing_reservation  viewing_reservation         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.ViewingReservationVO" >
		SELECT  viewing_reservation.* FROM viewing_reservation  viewing_reservation 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.ViewingReservationView" >

		SELECT  viewing_reservation.* FROM viewing_reservation  viewing_reservation 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.ViewingReservationView" >
		SELECT * FROM viewing_reservation  viewing_reservation <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

    <select id="selectValue" resultType="map" >
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM viewing_reservation
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.xColumn}
    </select>

    <select id="selectTimeStatValue" resultType="map" >
        <if test = 'params.timeStatType == "日"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM viewing_reservation
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM viewing_reservation
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test='params.timeStatType == "季"'>
                SELECT CONCAT(YEAR(${params.xColumn}), ' - ', ELT(QUARTER(${params.xColumn}), '第一季度', '第二季度', '第三季度', '第四季度')) as ${params.xColumn}, sum(${params.yColumn}) total FROM viewing_reservation
                <where> 1=1 ${ew.sqlSegment}</where>
                group by CONCAT(YEAR(${params.xColumn}), ' - ', ELT(QUARTER(${params.xColumn}), '第一季度', '第二季度', '第三季度', '第四季度'))
        </if>
        <if test = 'params.timeStatType == "年"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM viewing_reservation
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map" >
        SELECT ${params.column} , count(1) total FROM viewing_reservation
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.column}
    </select>




</mapper>
