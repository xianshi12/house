<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.NewsTypeDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.NewsTypeEntity" id="newsTypeMap">
        <result property="typename" column="typename"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.NewsTypeVO" >
		SELECT * FROM news_type  news_type         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.NewsTypeVO" >
		SELECT  news_type.* FROM news_type  news_type 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.NewsTypeView" >

		SELECT  news_type.* FROM news_type  news_type 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.NewsTypeView" >
		SELECT * FROM news_type  news_type <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
